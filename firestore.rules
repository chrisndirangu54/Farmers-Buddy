rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsFarm(farmId) {
      return signedIn() && exists(/databases/$(database)/documents/farms/$(farmId)) &&
        request.auth.uid in get(/databases/$(database)/documents/farms/$(farmId)).data.memberUids;
    }
    match /users/{uid} { allow read, write: if signedIn() && request.auth.uid == uid; }
    match /farms/{farmId} {
      allow read: if ownsFarm(farmId);
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberUids;
      allow update: if ownsFarm(farmId);
      match /{document=**} { allow read, write: if ownsFarm(farmId); }
    }
    match /actuation_commands/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.requestedBy == request.auth.uid;
      allow update, delete: if false;
    }
    match /audit_logs/{id} { allow read: if signedIn(); allow write: if false; }
  }
}
